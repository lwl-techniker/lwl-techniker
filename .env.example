# Diese vier Werte erzeugt Keystatic automatisch beim Einrichten der GitHub-App
# (siehe docs/03-github-verbinden.md). Keystatic schreibt sie in die Datei .env.
# Dieselben vier Werte müssen in Netlify als Umgebungsvariablen eingetragen werden.
# Die Datei .env niemals committen.

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
