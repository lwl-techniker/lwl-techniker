{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3109",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3109/",
        "http://localhost:3109/leistungen/ftth-installation",
        "http://localhost:3109/referenzen/weissenstein-tunnel-solothurn",
        "http://localhost:3109/produkte",
        "http://localhost:3109/kontakt"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
